Package: Bioc.gff
Title: Read and write GFF and GTF files
Version: 0.99.13
Date: 2025-07-07
Authors@R: c(
    person("Michael", "Lawrence", role = "aut"),
    person("Hervé", "Pagès", role = "aut"),
    person("Marcel", "Ramos", role = "ctb"),
    person(
      "Bioconductor", "Package Maintainer", ,
      "maintainer@bioconductor.org", "cre"
    )
